APP_NAME="SMAF 2"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://rhitcr.com/smaf2
APP_LOCALE=es
APP_FALLBACK_LOCALE=es
APP_TIMEZONE=America/Costa_Rica
SMAF_ADMIN_EMAIL=
GITHUB_REPOSITORY=juramirezcr/smaf2
GITHUB_TOKEN=

LOG_CHANNEL=stack
LOG_LEVEL=warning

DB_CONNECTION=mysql
DB_HOST=db
DB_PORT=3306
DB_DATABASE=smaf2
DB_USERNAME=smaf2
DB_PASSWORD=replace-with-a-generated-password
DB_ROOT_PASSWORD=replace-with-a-generated-root-password

SESSION_DRIVER=database
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax
CACHE_STORE=database
QUEUE_CONNECTION=database
# Debe superar el --timeout del worker (compose.yaml) para que un job lento
# no se marque disponible de nuevo antes de que el timeout lo mate.
DB_QUEUE_RETRY_AFTER=960
FILESYSTEM_DISK=local

REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=alertas@example.com
MAIL_FROM_NAME="${APP_NAME}"

SMAF_PORT=8082
